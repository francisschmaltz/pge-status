<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en-US" lang="en-US" prefix="og: http://ogp.me/ns#" class="no-js">
<head>
    <%- include('../partials/head', { viewportFit: true }) %>
    <link rel="stylesheet" href="styles/index.css">
</head>
<body class="body-fixed">
  <%- include('../partials/nav') %>
  <main>
      <div id="map"></div>
      <script>
        if (matchMedia('(pointer: coarse)').matches) {
          const map = document.getElementById('map');
          const sizeMap = () => {
            map.style.height = `${screen.height}px`;
            map.style.setProperty('--bottom-overhang', `${Math.max(0, screen.height - innerHeight)}px`);
          };
          sizeMap();
          visualViewport?.addEventListener('resize', sizeMap);
          addEventListener('resize', sizeMap);
        }
      </script>
      <div class="search-bar">
        <input id="originInput" type="text" class="origin" placeholder="Search for a place or address" autocomplete='off'/>
        <div id="autocomplete-box">
          <ul id="autocomplete-list"></ul>
        </div>
        <div id="psps-alert" class="alert alert-warn" style="display: none">PG&amp;E PSPS outages planned.</div>
      </div>
      <script src="https://cdn.apple-mapkit.com/mk/6/mapkit.js"></script>
      <script src="scripts/map.js?v2.0.18"></script>
  </main>
</body>
<style>
  body.body-fixed {
    position: static;
    overflow: clip;
  }
  #map {
      position: relative;
      width: 100%;
      height: 100lvh;
      touch-action: none;
  }
  #map .mk-controls-container {
    left: env(safe-area-inset-left, 0px) !important;
    right: env(safe-area-inset-right, 0px) !important;
    bottom: calc(var(--bottom-overhang, 0px) + env(safe-area-inset-bottom, 0px)) !important;
  }

  header {
    /* Override position on map */
    position: fixed !important;
    padding-top: env(safe-area-inset-top, 0px);
    padding-left: env(safe-area-inset-left, 0px);
    padding-right: env(safe-area-inset-right, 0px);
  }
  header .section-content {
    width: calc(100% - 32px) !important;
    padding-left: 16px;
    padding-right: 16px;
  }
  .search-bar {
    left: max(12px, env(safe-area-inset-left, 0px));
    right: max(12px, env(safe-area-inset-right, 0px));
    width: auto;
    top: calc(72px + env(safe-area-inset-top, 0px));
    max-height: calc(100dvh - 84px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px));
  }

</style>
</html>
